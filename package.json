{
  "name": "sept-agent",
  "version": "0.1.0",
  "description": "Durable Pi-native single-slot task worker",
  "type": "module",
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "sept": "dist/src/cli.js"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "./sept worker",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.{ts,mjs}\" \"scripts/**/*.{js,mjs,ts}\" \"eslint-rules/**/*.js\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.{ts,mjs}\" \"scripts/**/*.{js,mjs,ts}\" \"eslint-rules/**/*.js\" \"*.{json,mjs}\"",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test": "npm run build && node --test --test-concurrency=4 dist/test/**/*.test.js && node --test test/meta/*.test.mjs",
    "gate": "npm run check && npm test && npm audit --omit=dev",
    "prepack": "node scripts/ci/pack.mjs --reject-unsealed",
    "pack:consumer": "npm run build && node scripts/ci/pack.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-coding-agent": "file:vendor/pi-coding-agent-1.1.0-undici-8.12.2.tgz",
    "@earendil-works/pi-durable": "1.1.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.39.0",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.6.0",
    "prettier": "3.8.3",
    "typebox": "1.3.7",
    "typescript": "5.9.2",
    "typescript-eslint": "8.60.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DB-Conneely/sept.git"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./client": {
      "types": "./dist/src/client/index.d.ts",
      "import": "./dist/src/client/index.js"
    },
    "./hands": {
      "types": "./dist/src/hands.d.ts",
      "import": "./dist/src/hands.js"
    }
  },
  "files": [
    "dist/src",
    "src",
    "sept",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE",
    "examples/node-app",
    "examples/incident-investigator",
    "image/pi-native-search/README.md",
    "image/pi-native-search/native-search.patch",
    "image/pi-native-search/overlay.tgz",
    "image/pi-native-search/provenance.json",
    "vendor/README.md",
    "vendor/pi-coding-agent-provenance.json"
  ]
}
