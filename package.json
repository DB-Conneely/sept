{
  "name": "sept-agent",
  "version": "0.1.0",
  "description": "Durable Pi-native single-slot coding-agent worker",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "sept": "dist/src/cli.js"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "./sept worker",
    "test": "npm run build && node --test --test-concurrency=4 dist/test/**/*.test.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.39.0",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "typebox": "1.3.7",
    "typescript": "5.9.2"
  }
}
