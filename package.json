{
  "name": "sept-agent",
  "version": "0.1.0",
  "description": "Durable Pi-native single-slot coding-agent worker",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "sept": "dist/src/cli.js"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "./sept worker",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.{ts,mjs}\" \"scripts/**/*.{js,mjs,ts}\" \"eslint-rules/**/*.js\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.{ts,mjs}\" \"scripts/**/*.{js,mjs,ts}\" \"eslint-rules/**/*.js\" \"*.{json,mjs}\"",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test": "npm run build && node --test --test-concurrency=4 dist/test/**/*.test.js && node --test test/meta/*.test.mjs",
    "gate": "npm run check && npm test && npm audit --omit=dev"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.39.0",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.6.0",
    "prettier": "3.8.3",
    "typebox": "1.3.7",
    "typescript": "5.9.2",
    "typescript-eslint": "8.60.1"
  }
}
